# Paste variables into Railway, not into source code. This file is not auto-loaded.
OPULENT_PUBLIC_URL=https://YOUR-APP.up.railway.app
OPULENT_SETUP_TOKEN=REPLACE-WITH-A-PRIVATE-RANDOM-CODE-AT-LEAST-24-CHARACTERS
DATABASE_URL=${{Postgres.DATABASE_URL}}
OPULENT_EXTERNAL_WORKER=1
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=REPLACE_WITH_SANDBOX_API_KEY
AFRICASTALKING_PRODUCTION_USERNAME=REPLACE_WITH_PRODUCTION_USERNAME
AFRICASTALKING_PRODUCTION_API_KEY=REPLACE_WITH_PRODUCTION_API_KEY
AFRICASTALKING_PRODUCTION_TEST_NUMBER=REPLACE_WITH_ONE_AUTHORIZED_TEST_NUMBER
OPULENT_PRODUCTION_SMS_TEST_ENABLED=false
# EgoSMS (Pahappa Comms). Secret values stay in Railway, never in source control.
EGOSMS_USERNAME=REPLACE_WITH_COMMS_API_USERNAME
EGOSMS_API_KEY=REPLACE_WITH_COMMS_API_KEY
EGOSMS_SENDER_ID=EgoSMS
EGOSMS_ENDPOINT=https://comms.egosms.co/api/v1/json/
EGOSMS_SANDBOX_USERNAME=REPLACE_WITH_SANDBOX_API_USERNAME
EGOSMS_SANDBOX_API_KEY=REPLACE_WITH_SANDBOX_API_KEY
EGOSMS_PRODUCTION_TEST_NUMBER=REPLACE_WITH_ONE_AUTHORIZED_TEST_NUMBER
# Keep live reminders disabled until explicitly authorized.
OPULENT_LIVE_SMS_ENABLED=false
# Web service only: unguessable path token for the EgoSMS delivery-report webhook.
EGOSMS_WEBHOOK_TOKEN=REPLACE_WITH_A_LONG_RANDOM_WEBHOOK_TOKEN
# Railway supplies PORT. Add a Railway PostgreSQL service; no application volume is needed.
